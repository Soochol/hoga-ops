{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: dev (hot reload)",
      "type": "shell",
      "command": "uv run uvicorn hoga.api.app:default_app --factory --host 127.0.0.1 --port 8000 --reload --reload-dir hoga",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "panel": "dedicated",
        "group": "dev",
        "reveal": "always",
        "clear": false
      },
      "problemMatcher": {
        "owner": "uvicorn",
        "pattern": {
          "regexp": "^$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Started reloader process",
          "endsPattern": "Application startup complete\\."
        }
      }
    },
    {
      "label": "Frontend: dev (HMR)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "presentation": {
        "panel": "dedicated",
        "group": "dev",
        "reveal": "always",
        "clear": false
      },
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE v",
          "endsPattern": "ready in"
        }
      }
    },
    {
      "label": "Dev: backend + frontend",
      "dependsOn": ["Backend: dev (hot reload)", "Frontend: dev (HMR)"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "Dev: kill all servers",
      "type": "shell",
      "command": "pkill -f '[u]vicorn hoga.api.app'; pkill -f 'hoga-ops.*[v]ite'; sleep 1; ss -tln | grep -E ':(8000|517[0-9])' && echo '⚠ 아직 살아있는 리스너 위 참조' || echo '✔ 모든 dev 서버 종료됨'",
      "presentation": {
        "panel": "dedicated",
        "group": "dev",
        "reveal": "always",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
