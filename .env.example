# Copy this file to .env and fill in your values.
# .env is gitignored; do not commit secrets.

# Hogaplay session cookie. Copy from a logged-in browser session,
# format: "k_=...; n_=...". Optional if you keep using the legacy
# .cookie file at the repo root.
HOGAPLAY_COOKIE=

# KIS OpenAPI credentials (한국투자증권, 실전투자). Required for the /live
# real-time chart: 라이브 스트림이 시작 시 이 값을 읽고(hoga/live/lifecycle.py)
# 둘 중 하나라도 없으면 오프라인으로 남아 /live 에 "KIS 자격증명이 설정되지
# 않았습니다" 배너가 뜬다. hoga 는 항상 실전투자(env="real")를 쓰며 모의투자 키는
# 지원하지 않는다. 발급: https://apiportal.koreainvestment.com/.
KIS_APP_KEY=your-kis-app-key
KIS_APP_SECRET=your-kis-app-secret

# ── 부팅 시 자동 복구 (장중 크래시·재시작 대비) ──────────────────────────────
#
# 둘 다 기본 off 이고, off 인 채로는 **프로세스를 재시작해도 수집이 재개되지 않는다**
# — 사용자가 UI 에서 직접 시작할 때까지 멈춰 있다. 장중에 프로세스가 죽는 상황을
# 자동 복구하려면 프로세스 감독자(README "운영: 프로세스 감독" 참고)와 함께 켤 것.
#
#  - HOGA_LIVE_STARTUP_ENABLED: 부팅 시 라이브 수집을 자동 시작한다. off 면
#    /live 가 "미가동" 상태로 뜨고, 그 상태는 자격증명 문제와 구별하기 어렵다.
#  - HOGA_STARTUP_CATCHUP_ENABLED: 부팅 시 관심종목의 미보유 거래일을 한 번
#    훑어 큐에 넣는다(놓친 날짜 복구). off 면 다운타임 동안 빠진 날짜를 메우는
#    경로가 없다 — 일일 런은 오늘 날짜만 넣는다.
#
# 무인 운영을 원하면 둘 다 true 를 권한다.
# HOGA_LIVE_STARTUP_ENABLED=true
# HOGA_STARTUP_CATCHUP_ENABLED=true

# Today Promotion(라이브 JSONL → parquet 승격) 루프. 기본 on / 300초.
# off 로 두면 당일 데이터가 parquet 으로 넘어가지 않아 /study·지표가 늦게 따라온다.
# HOGA_LIVE_TODAY_PROMOTE_ENABLED=true
# HOGA_LIVE_TODAY_PROMOTE_INTERVAL_S=300

# 데이터·로그 위치. 미설정 시 플랫폼 표준 경로(hoga/config.py).
# HOGA_DATA_DIR=/path/to/data
# HOGA_LOG_DIR=/path/to/logs

# 느린 요청 경고 임계(ms, 기본 2000). 5xx 는 이 임계와 무관하게 항상 로그된다.
# HOGA_SLOW_REQUEST_MS=2000

# 키움증권 OpenAPI credentials (ADR-0116, 실시간 WS 병행 수집). Optional — 미설정 시
# 키움 경로는 완전 휴면(히트맵은 KIS로 수집). 앱키당 WS 200종목이라 4앱키 = 호가+체결
# 800종목. account 0 = 접미 없음, k>0 = 접미 (k+1); configured_account_ids가 0부터
# 연속으로 감지하므로 번호를 건너뛰지 말 것. 발급: https://openapi.kiwoom.com/.
# 병행 수집을 실제로 켜는 건 env가 아니라 런타임 설정 kiwoom_enabled(기본 off) —
# Settings UI "키움 WS 병행 수집" 토글 또는 PATCH /api/live/settings.
# KIWOOM_APP_KEY=your-kiwoom-app-key
# KIWOOM_APP_SECRET=your-kiwoom-app-secret
# KIWOOM_APP_KEY_2=your-kiwoom-app-key-2
# KIWOOM_APP_SECRET_2=your-kiwoom-app-secret-2
# KIWOOM_APP_KEY_3=your-kiwoom-app-key-3
# KIWOOM_APP_SECRET_3=your-kiwoom-app-secret-3
# KIWOOM_APP_KEY_4=your-kiwoom-app-key-4
# KIWOOM_APP_SECRET_4=your-kiwoom-app-secret-4

# 오늘자 지표(호가비·체결강도·peak-wall) short-TTL 캐시 (ms). 0 = 비활성(ADR-0043
# 원 동작: 오늘은 매 요청 재계산). 기본 15000. 심볼 전환·다중 클라이언트 버스트에서
# 오늘자 재계산을 TTL당 1회로 접는다. ADR-0090.
# HOGA_TODAY_INDICATOR_TTL_MS=15000

# raw 보존 기간(달력일, 기본 3). Daily Scheduler 와 `hoga prune` 이 공유한다.
# 이 기간이 지난 raw 중 **hogaplay-source parquet 이 COMPLETE 인 것만** 삭제된다
# (ADR-0075). resume 소스(CLIENT_INCOMPLETE)·미확정 갭·센티널은 보존된다.
#
# 주의: 보존되는 쪽이 느리게 누적된다. 실측 2026-07-29 에 유예 밖 raw 351GB 중
# COMPLETE 는 0건이었고 나머지가 전부 게이트에 걸려 있었다. `hoga prune` 을
# 인자 없이 돌리면 무엇이 어떤 사유로 얼마나 잡혀 있는지 표로 나온다.
# 확인된 업스트림 갭까지 회수하려면 `hoga prune --include-confirmed-gaps`.
# HOGA_RETENTION_DAYS=3

# 호가플레이 수집 부하 조절(업스트림 예의). 둘 다 pool-start(load_env 후)에 반영.
#  - HOGA_MAX_CONCURRENT: 동시 수집 Stock-Date 수(양의 정수, 기본 3). 클수록 부하↑.
#  - HOGA_RATE_LIMIT_S: 페이지 요청 간 대기(초, 스트림당, 0 이상). 작을수록 부하↑.
#    미설정 시 코드 기본값(DEFAULT_RATE_LIMIT_S). 순간부하 ≈ 동시수 × (1/간격) req/s.
# HOGA_MAX_CONCURRENT=3
# HOGA_RATE_LIMIT_S=0.15
