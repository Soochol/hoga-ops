# Copy this file to .env and fill in your values.
# .env is gitignored; do not commit secrets.

# Hogaplay session cookie. Copy from a logged-in browser session,
# format: "k_=...; n_=...". Optional if you keep using the legacy
# .cookie file at the repo root.
HOGAPLAY_COOKIE=

# KIS OpenAPI credentials (한국투자증권, 실전투자). Required for the /live
# real-time KIS chart: the live poller reads these at startup
# (hoga/live/lifecycle.py) and stays offline if either is missing, which
# surfaces as the "KIS 자격증명이 설정되지 않았습니다" banner on /live. hoga
# always uses real-trading (env="real"); paper/모의투자 keys are not supported.
# Issue an app key/secret at https://apiportal.koreainvestment.com/.
KIS_APP_KEY=your-kis-app-key
KIS_APP_SECRET=your-kis-app-secret
