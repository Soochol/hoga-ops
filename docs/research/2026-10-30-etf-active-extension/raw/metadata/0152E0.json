 종목을 최초 유니버스로 하고, 예상배당수익률을 기준으로 선별된 고배당 기업 최대 20 종목(10~20종목)으로 구성합니다.해당 ETF투자의 경우 1주당 10,000원(최초 설정시점 기준)으로 투자를 할 수 있습니다. 설정단위는 50,000좌이며, 현금설정 방식으로 이루어집니다. 한국거래소를 통하여 매매하는 경우에는 1주 단위로 거래할 수 있습니다.","etfKeyIndicator":{"issuerName":"신한자산운용","marketValue":"224억","dividendYieldTtm":4.74,"totalNav":"229억","nav":"9,960.80","deviationSign":"-","deviationRate":0.41,"totalFee":0.3000,"returnRate1m":-7.20,"returnRate3m":-4.15,"marketValueRaw":"22448000000"},"dealTrendInfos":[{"itemCode":"0152E0","bizdate":"20261029","foreignerPureBuyQuant":"0","foreignerHoldRatio":"0.22%","organPureBuyQuant":"+2,943","individualPureBuyQuant":"-3,040","closePrice":"9,920","compareToPreviousClosePrice":"70","compareToPreviousPrice":{"code":"2","text":"상승","name":"RISING"},"accumulatedTradingVolume":"10,092"},{"itemCode":"0152E0","bizdate":"20261028","foreignerPureBuyQuant":"+9","foreignerHoldRatio":"0.22%","organPureBuyQuant":"+1,303","individualPureBuyQuant":"-2,099","closePrice":"9,900","compareToPreviousClosePrice":"175","compareToPreviousPrice":{"code":"2","text":"상승","name":"RISING"},"accumulatedTradingVolume":"16,219"},{"itemCode":"0152E0","bizdate":"20261027","foreignerPureBuyQuant":"-4","foreignerHoldRatio":"0.22%","organPureBuyQuant":"+6,597","individualPureBuyQuant":"-6,662","closePrice":"9,725","compareToPreviousClosePrice":"105","compareToPreviousPrice":{"code":"2","text":"상승","name":"RISING"},"accumulatedTradingVolume":"12,390"},{"itemCode":"0152E0","bizdate":"20261026","foreignerPureBuyQuant":"0","foreignerHoldRatio":"0.22%","organPureBuyQuant":"-2,730","individualPureBuyQuant":"+2,730","closePrice":"9,620","compareToPreviousClosePrice":"-190","compareToPreviousPrice":{"code":"5","text":"하락","name":"FALLING"},"accumulatedTradingVolume":"5,403"},{"itemCode":"0152E0","bizdate":"20261023","foreignerPureBuyQuant":"-176","foreignerHoldRatio":"0.22%","organPureBuyQuant":"+5,832","individualPureBuyQuant":"-5,657","closePrice":"9,810","compareToPreviousClosePrice":"-140","compareToPreviou