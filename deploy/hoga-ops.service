# hoga-ops 프로세스 감독용 systemd user unit.
#
# 왜 필요한가: 앱 내부 워치독(키움 WS 재연결, KIS 용량 워커 자가재생성)은 전부
# **프로세스 안에서만** 동작한다. 장중 09:05 에 프로세스가 죽으면 그날 실시간 수집은
# 그 시점에서 끝나고, 더 나쁜 건 죽었다는 사실 자체를 저녁에 데이터 구멍으로 알게
# 된다는 것이다. 프로세스 사망은 구조적으로 외부 감독자만 덮을 수 있다.
#
# 설치:
#   mkdir -p ~/.config/systemd/user ~/.config/hoga-ops
#   cp deploy/hoga-ops.service ~/.config/systemd/user/
#   cp deploy/hoga-ops.env.example ~/.config/hoga-ops/deploy.env
#   # deploy.env 의 바인드 주소와 이 파일의 WorkingDirectory 를 고치고:
#   systemctl --user daemon-reload
#   systemctl --user enable --now hoga-ops
#
# 로그아웃 후에도 계속 돌게 하려면(노트북 기준 권장):
#   loginctl enable-linger "$USER"
#
# 상태·로그:
#   systemctl --user status hoga-ops
#   journalctl --user -u hoga-ops -f
#
# 자동 시작 스위치를 함께 켜야 의미가 있다 — 감독자가 되살려도
# HOGA_LIVE_STARTUP_ENABLED 가 off 면 수집은 재개되지 않는다(.env.example 참고).

[Unit]
Description=hoga-ops local API server
Documentation=https://github.com/Soochol/hoga-ops
# user 유닛에는 network-online.target 이 **없다**(시스템 매니저의 타깃이라 user
# 매니저 네임스페이스에 존재하지 않는다) — 여기 적어도 순서가 강제되지 않는다.
# 부팅 레이스는 아래 ExecStartPre 가 실제로 막는다.

[Service]
Type=simple
# ↓ 실제 체크아웃 경로로 교체할 것.
WorkingDirectory=%h/code/hoga-ops
# 앱 설정(.env)은 앱이 스스로 읽는다(default_app() → load_env()). 여기서 읽는
# 것은 **배포 좌표**뿐이다 — 바인드 주소를 워치독과 공유하기 위한 단일 진실
# (deploy/hoga-ops.env.example). 없으면 아래 기본값(루프백)이 남는다.
Environment=HOGA_BIND_HOST=127.0.0.1
Environment=HOGA_BIND_PORT=8000
EnvironmentFile=-%h/.config/hoga-ops/deploy.env
#
# 바인드 주소가 인터페이스에 올라올 때까지 기다린다. 재부팅(정전 복구)에서
# user 매니저는 linger 로 즉시 기동하는데 tailscaled 는 아직 인터페이스를 안
# 올렸을 수 있고, 그러면 uvicorn 의 bind 가 EADDRNOTAVAIL 로 즉사한다 —
# Restart=always 가 5초 간격으로 5번 재시도하고 끝나 **유닛이 failed 로 고착**
# 한다(그때는 Restart 가 더 이상 동작하지 않는다). 무인 서버가 정전 다음 날
# 아침까지 죽어 있는 경로가 정확히 이것이었다.
ExecStartPre=/usr/bin/env bash deploy/hoga-ops-wait-bind.sh
# 위 대기(최대 60초)는 기본 TimeoutStartSec(90초)에 아슬아슬하다 — 여유를 준다.
TimeoutStartSec=120
#
# prod(ADR-0134)는 HOGA_BIND_HOST 를 tailscale 인터페이스 주소로 바꾼다. 공인·
# LAN 인터페이스(0.0.0.0 등) 금지 — README "Access model" 참고.
#
# --frozen: 재시작마다 uv 가 락파일을 재해석·동기화하는 것을 막는다(#998) —
# 재시작이 네트워크·인덱스 상태에 좌우되면 안 된다. 의존성 갱신은 업그레이드
# 러닝북(README)의 `uv sync --frozen` 단계가 재시작 **전에** 명시적으로 한다.
#
# 단일 워커 전제: 이 앱은 프로세스 내 싱글턴(키움 WS 세션·일일 스케줄러·DuckDB)
# 구조다. uvicorn 직접 기동 시에도 --workers 를 절대 붙이지 말 것 — 워커마다
# 키움 WS 를 중복 접속(킥 전쟁)하고 스케줄러가 N중 실행된다.
ExecStart=/usr/bin/env uv run --frozen hoga serve --host ${HOGA_BIND_HOST} --port ${HOGA_BIND_PORT}

Restart=always
RestartSec=5
# 재시작 폭주 방지: 5분 안에 5회를 넘기면 멈춘다(설정 오류로 즉시 죽는 경우
# 무한 루프를 돌지 않게). 이때는 journalctl 로 원인을 봐야 한다.
StartLimitIntervalSec=300
StartLimitBurst=5

# 종료 유예. 캡처 워커가 스레드에서 돌고 큐 flock 해제까지 마쳐야 하므로
# SIGKILL 을 너무 빨리 보내지 않는다.
TimeoutStopSec=30
KillSignal=SIGINT

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
