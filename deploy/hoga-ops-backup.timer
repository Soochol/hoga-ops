# 매일 18:30 백업.
#
# 시각 근거: 일일 스케줄러가 17:00 KST 에 돌아 promote(JSONL→parquet) → archive 이동
# → prune 을 수행한다(hoga/api/scheduler.py `_DAILY_TRIGGER_HOUR = 17`). 그 뒤에
# 떠야 parquet 이 확정되고 JSONL append 도 멎은 사본을 얻는다. 90분 여유는 일일 런이
# 종목 수에 따라 길어질 수 있어서다 — 완료 여부는 백업 출력이 알려 준다
# (`last_daily_run_date` 마커 확인).
#
# **시스템 시간대가 KST 가 아니면 OnCalendar 를 고칠 것.** systemd 는 시스템 로컬
# 시간으로 해석한다. `timedatectl` 로 확인하고, UTC 머신이면 09:30 으로 바꾼다.

[Unit]
Description=Run hoga-ops backup daily after the 17:00 daily run
Documentation=https://github.com/Soochol/hoga-ops

[Timer]
OnCalendar=*-*-* 18:30:00
# 노트북 필수: 그 시각에 꺼져 있었으면 다음 부팅 직후 따라잡는다. 이게 없으면
# 주말에 덮어 둔 노트북은 백업을 통째로 건너뛴다.
Persistent=true
AccuracySec=1min
Unit=hoga-ops-backup.service

[Install]
WantedBy=timers.target
