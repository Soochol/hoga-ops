# hoga-ops 배포 좌표 — 서비스 유닛과 워치독이 **공유**하는 단일 진실.
#
# 설치:
#   mkdir -p ~/.config/hoga-ops
#   cp deploy/hoga-ops.env.example ~/.config/hoga-ops/deploy.env
#   # 아래 값을 실제 배포에 맞게 고친다.
#
# 왜 파일로 빼는가: 바인드 주소가 두 유닛(서비스의 ExecStart, 워치독의 health
# URL)에 각각 리터럴로 있으면 한쪽만 고쳐지는 사고가 난다 — prod 를 tailscale
# 주소로 옮기면서 워치독을 루프백에 둔 채로 두면, curl 이 영원히 실패해
# **완벽히 건강한 서버를 장중 5분마다 재시작**한다. 증상이 "조용히 죽은 태스크"
# 와 구별되지 않아 원인 특정도 어렵다. 그래서 좌표는 한 곳에만 적는다.
#
# 이 파일이 없어도 두 유닛은 기동한다 — 유닛의 Environment= 기본값(루프백)이
# 남고, EnvironmentFile 은 `-` 접두로 선택이다. dev 는 그대로 두면 된다.

# 바인드 주소. prod(ADR-0134)는 tailscale 인터페이스의 IP 다.
# **공인·LAN 인터페이스(0.0.0.0 등) 금지** — README "Access model" 참고.
# ExecStartPre 가 이 주소가 인터페이스에 나타날 때까지 기다리므로, 이름이 아니라
# `ip addr` 에 실제로 보이는 IP 를 적는다.
HOGA_BIND_HOST=127.0.0.1

# 포트. :80 은 setcap/sysctl 의존이라 기각됐다(ADR-0134 §3).
HOGA_BIND_PORT=8000

# 백업 대상(hoga-ops-backup.timer). 비우면 백업이 실행 시점에 거부된다.
# **다른 물리 디스크여야 의미가 있다** — 같은 디스크 안의 복사는 디스크가 죽는
# 시나리오를 못 덮는다. 외장 디스크나 tailnet 안 다른 머신의 마운트를 권한다.
# 대상 안에 센티널을 한 번 만들어야 실행된다(마운트 실패·오타 방지):
#   touch "$HOGA_BACKUP_DEST/.hoga-backup-root"
#HOGA_BACKUP_DEST=/mnt/backup/hoga-ops

# 데이터 디렉터리. 기본값(~/.local/share/hoga-ops/data)이 아닐 때만 적는다 —
# 백업 스크립트가 원본 경로를 알아야 한다.
#HOGA_DATA_DIR=/home/you/.local/share/hoga-ops/data
